    },
    "Gemini": {
        "ApiKey": "YOUR_GEMINI_API_KEY_HERE",
        "ProjectId": "your-google-cloud-project-id",
        "LocationId": "us-central1"
    },
    "Anthropic": {
        "ApiKey": "YOUR_ANTHROPIC_API_KEY_HERE"
    },
    "VertexAI": {
        "ProjectId": "YOUR_GCP_PROJECT_ID",
        "Location": "us-central1"
    }
