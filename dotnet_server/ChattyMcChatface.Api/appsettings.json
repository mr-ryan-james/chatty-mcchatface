{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Jwt": {
        "Issuer": "ChattyMcChatfaceApi",
        "Audience": "ChattyMcChatfaceClient",
        "Key": "VERY_SECRET_KEY_REPLACE_IN_PRODUCTION_1234567890"
    },
    "OpenAI": {
        "ApiKey": "YOUR_OPENAI_API_KEY_HERE"
    },
    "AzureOpenAI": {
        "ApiKey": "YOUR_AZURE_OPENAI_API_KEY_HERE",
